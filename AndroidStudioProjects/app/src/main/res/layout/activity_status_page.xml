<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Pet Image -->
    <ImageView
        android:id="@+id/profile_picture"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:contentDescription="Pet Profile Picture"
        android:src="@drawable/ic_dog" />

    <!-- Pet Name -->
    <TextView
        android:id="@+id/pet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Pet Name: Doggo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Pet Age -->
    <TextView
        android:id="@+id/pet_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Age: 3"
        android:textSize="16sp"
        android:layout_marginBottom="4dp" />

    <!-- Pet Breed/Species -->
    <TextView
        android:id="@+id/pet_breed_species"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Breed/Species: Labrador"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <!-- Schedule Button -->
    <Button
        android:id="@+id/schedule_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Schedule"
        android:layout_marginTop="16dp" />

    <!-- Logout Button -->
    <Button
        android:id="@+id/logout_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Logout"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/check_pet_health_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Check Pet Health"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/instagram_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Follow us on Instagram"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/fetch_cat_fact_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Get Cat Fact"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/cat_fact_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Cat Fact will appear here"
        android:layout_marginTop="8dp" />



</LinearLayout>

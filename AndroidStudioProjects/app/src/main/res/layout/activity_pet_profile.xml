<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Animal Image -->
    <ImageView
        android:id="@+id/profile_picture"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_dog" />

    <!-- Animal Type -->
    <TextView
        android:id="@+id/animal_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/animal_type_label"
        android:textSize="18sp" />

    <!-- Pet Name -->
    <EditText
        android:id="@+id/pet_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pet_name_hint"
        android:layout_marginTop="20dp"
        android:inputType="text"
        android:autofillHints="name"
        android:padding="12dp"
        android:minHeight="48dp" />

    <!-- Pet Age -->
    <EditText
        android:id="@+id/pet_age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pet_age_hint"
        android:layout_marginTop="8dp"
        android:inputType="number"
        android:autofillHints="age"
        android:padding="12dp"
        android:minHeight="48dp" />

    <!-- Breed/Species -->
    <EditText
        android:id="@+id/pet_breed_species"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pet_breed_species_hint"
        android:layout_marginTop="8dp"
        android:inputType="text"
        android:autofillHints="species"
        android:padding="12dp"
        android:minHeight="48dp" />

    <!-- Save Button -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save"
        android:padding="12dp"
        android:minHeight="48dp" />

    <!-- View Saved Pets Button -->
    <Button
        android:id="@+id/view_pets_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/view_saved_pets"
        android:padding="12dp"
        android:minHeight="48dp" />

    <!-- Saved Pets List -->
    <TextView
        android:id="@+id/saved_pets_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>

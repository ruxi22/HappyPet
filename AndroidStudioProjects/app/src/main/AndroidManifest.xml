<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />


    <!-- Declare necessary permissions here -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <uses-permission android:name="android.permission.INTERNET" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HappyPet"
        tools:targetApi="31">

        <activity
            android:name=".ScheduleActivity"
            android:theme="@style/Theme.HappyPet" />


        <!-- Login Activity as the launcher activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HappyPet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HappyPet" >
        </activity>

        <!-- Pet Profile Activity -->
        <activity
            android:name=".PetProfileActivity"
            android:exported="true"
            android:theme="@style/Theme.HappyPet" >
        </activity>

        <activity android:name=".StatusPageActivity" />

        <activity android:name=".SignUpActivity" />

        <receiver android:name=".NotificationReceiver" />

        <!-- Pet Reminder Service -->
        <service
            android:name=".PetReminderService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
        </service>

        <service android:name=".BackgroundService" />
        <service android:name=".BoundPetService" />
        <receiver android:name=".PetHealthReceiver" />

        <provider
            android:name=".InstagramContentProvider"
            android:authorities="com.example.happypet.provider"
            android:exported="true" />

    </application>

</manifest>
